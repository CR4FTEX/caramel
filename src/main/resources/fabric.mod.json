{
	"schemaVersion": 1,
	"id": "caramel",
	"version": "${version}",
	"name": "Caramel",
	"description": "Builds atop vanilla Minecraft: better crafting and building, structures and mobs worth seeking out, and content from the spin-offs, the yearly votes and concept art for every biome of every dimension.",
	"authors": [
		"CR4FTEX"
	],
	"contributors": [
		"Lorenzo N."
	],
	"contact": {
		"sources": "https://github.com/CR4FTEX/caramel",
		"issues": "https://github.com/CR4FTEX/caramel/issues"
	},
	"license": [
		"MIT",
		"CC-BY-NC-SA-4.0"
	],
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.cr4ftex.caramel.Caramel"
		],
		"client": [
			"io.github.cr4ftex.caramel.client.CaramelClient"
		],
		"fabric-datagen": [
			"io.github.cr4ftex.caramel.client.datagen.CaramelDataGenerator"
		]
	},
	"mixins": [
		"caramel.mixins.json",
		{
			"config": "caramel.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
